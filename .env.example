# Copy to .env.local and fill in. Never commit .env.local.
# Format is KEY=value (an equals sign, no spaces, no quotes needed).
# Check what is set (values are never printed): npm run env:check

# Public site address, no trailing slash. Used for email links and passkeys.
# Local: http://localhost:3000   Production: https://thegrandstrategist.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase dashboard > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase dashboard > Project Settings > API Keys > Publishable key (sb_publishable_...)
# Safe in the browser: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard > Project Settings > API Keys > Secret key (sb_secret_...)
# SERVER ONLY. Bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, used only by `npm run db:push` (supabase db push).
# Supabase dashboard > Connect > Session pooler (works on IPv4 networks).
DATABASE_URL=

# --- Email (Sprint 3) -------------------------------------------------------
# Production sends through Resend (resend.com > API Keys). SERVER ONLY.
# Leave empty until the sending domain is verified: emails then wait in the
# queue and the reason is logged. Nothing is lost.
RESEND_API_KEY=

# Sender, on the domain verified in Resend (owner decision), for example:
# The Grand Strategist <notifications@thegrandstrategist.com>
EMAIL_FROM=

# Shared secret for the email processor route (/api/email/process). Any long
# random string, e.g. `openssl rand -hex 32`. The same value goes in Supabase
# Vault as email_processor_secret (see DEMO.md). SERVER ONLY.
EMAIL_PROCESSOR_SECRET=

# Optional: force a transport ("resend" or "mailpit"). Normally chosen for you:
# Resend when RESEND_API_KEY is set, otherwise Mailpit when MAILPIT_URL is set.
EMAIL_TRANSPORT=

# Local development only: the local Supabase test inbox (npx supabase status).
# Written to .env.test.local by `npm run test:env`; leave empty in production.
MAILPIT_URL=

# Not needed until Sprint 4 (AI calls are stubbed in src/lib/ai until then).
ANTHROPIC_API_KEY=
